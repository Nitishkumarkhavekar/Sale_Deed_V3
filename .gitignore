# ============================================================================
# Sale Deed AI - what git must never take
#
# Three categories, for three different reasons:
#
#   1. Weights and binaries (38 GB). Git stores them badly, they are not
#      source, and they are reproducible from the setup scripts.
#   2. Runtime output. Regenerated by the application; deleting `runtime/`
#      loses nothing but logs and exports.
#   3. Operator data and secrets. Real sale deeds are third-party personal
#      information and must not enter version control at all.
# ============================================================================

# -- 1. Weights and binaries -------------------------------------------------

# vLLM's own virtualenv - several GB of torch and CUDA libraries, created by
# the installer on hardware that can use them. Not source.
models/vllm-env/

# 37 GB: the fine-tuned checkpoints, the GGUFs, Surya, the translator, and
# Surya's own virtualenv. Installed by System Setup.bat, never committed.
models/*

# ...except the extraction prompt, which is 1.4 KB of text and is application
# logic, not a weight. It was excluded by where it happens to live rather than
# by any decision, and the cost of that was a fresh clone passing setup and
# preflight and then failing at the first extraction with nothing to explain
# it. Setup cannot download it and no substitute will do.
!models/saledeed main/
models/saledeed main/*
!models/saledeed main/prompt_v6_short.txt

# 1.1 GB of llama.cpp CUDA binaries and DLLs. A build artefact, not source.
src/tools/llamacpp/

*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.whl

# -- 2. Runtime output -------------------------------------------------------

# Uploads, prepared copies, exports, logs, backups, caches. All regenerated.
runtime/

# -- 3. Operator data and secrets --------------------------------------------

# The database password lives here. Never commit it; `.env.example` documents
# the shape instead.
.env
.env.*
!.env.example

# Real sale deeds - third-party personal data (names, PANs, Aadhaar numbers).
# The tests that need them skip when the corpus is absent, by design.
tests/corpus/

# Anything a developer parked locally.
*.pdf
!docs/**/*.pdf

# -- Python ------------------------------------------------------------------

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtualenvs, wherever they were made.
.venv/
venv/
venv_new/
env/

# -- Editors and OS ----------------------------------------------------------

.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
$RECYCLE.BIN/
